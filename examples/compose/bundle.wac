// Step 1: bundle a suite with its context provider.
// The bundle exports everything a runner core imports: the suite's
// `tests` plus the provider's `test-context` and `factory` (all backed
// by one shared provider instance, so the `context` resource type is
// the same across all three).
package polymorph:suite-bundle;

let provider = new polymorph:provider-impl { ... };

let suite = new polymorph:sample-suite {
  "polymorph:component-test/test-context@0.1.0": provider["polymorph:component-test/test-context@0.1.0"],
  ...
};

export provider["polymorph:component-test/test-context@0.1.0"];
export provider["polymorph:component-test-provider/factory@0.1.0"];
export suite["polymorph:component-test/tests@0.1.0"];
