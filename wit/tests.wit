/// `lann:component-test` is the contract between test *suites* — components
/// that carry test cases — and test *runners* — components or hosts that
/// execute the cases and report results. A suite exports `tests`; a runner
/// imports it; composing the two (e.g. `wac plug`) yields something
/// executable.
package lann:component-test@0.1.0;

/// The enumeration-and-execution surface a test suite exports.
interface tests {
    /// The outcome of one executed test case.
    variant outcome {
        /// The observed behavior matched the expectation.
        pass,
        /// The observed behavior diverged; the payload says how, in one
        /// line.
        fail(string),
        /// A feature this case exercises was declared missing by the
        /// target. The payload says what the case asserted instead of
        /// exercising its subject.
        skipped(string),
    }

    /// One test case.
    resource test-case {
        /// Stable identity, unique within the suite: hierarchical
        /// `/`-separated segments (e.g. `group/source/case`). Runners and
        /// reporting tools group by prefix.
        name: func() -> string;

        /// The feature names this case exercises beyond the suite's
        /// baseline surface (empty for most cases).
        features: func() -> list<string>;

        /// Run the case. Expectation mismatches are reported as `fail`,
        /// never as traps, so a run always yields an outcome. A runner
        /// treats a trap as this case's failure and the suite instance as
        /// poisoned.
        run: async func() -> outcome;
    }

    /// Materialize the suite for a target missing the named features, in
    /// suite order. Feature names unknown to the suite trap: a misspelled
    /// declaration is a harness bug, not a test outcome.
    all: func(missing-features: list<string>) -> list<test-case>;
}

/// A test suite: carries cases and exports them to a runner.
world suite {
    export tests;
}

/// A test runner: imports a suite and executes it. Concrete runners extend
/// this world with the transport they report over (`wasi:cli/run`,
/// `wasi:http/incoming-handler`, ...).
world runner {
    import tests;
}
